# ====================================================================
#                          *** MASTER CONFIGURATION ***
# ====================================================================
# This single .env file, located in the root 'Backend' directory,
# configures all 6 microservices.

# ======================================================
# GLOBAL INFRASTRUCTURE
# ======================================================
# The single, central database for the entire application.
# Make sure the database name here matches the one you create in PostgreSQL.
CENTRAL_DATABASE_URL=postgresql+asyncpg://farmvidhya:password@localhost:5432/farmvidhya_prod_db

# The bootstrap server(s) for your Kafka cluster
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ======================================================
# AZURE STORAGE CONFIGURATION
# ======================================================
# Get this from the "Access keys" section of your Azure Storage Account
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_UPLOADS_CONTAINER="uploads"
AZURE_STORAGE_RESULTS_CONTAINER="results"
AZURE_STORAGE_UPLOADS_QUEUE="upload-notifications"

# ======================================================
# SERVICE DISCOVERY (URLs for inter-service communication)
# ======================================================
# These are correct for local development.
IDENTITY_SERVICE_URL=http://localhost:8001
QUEUE_SERVICE_URL=http://localhost:8003
BILLING_SERVICE_URL=http://localhost:8004

# ======================================================
# EXTERNAL ML APIs (Used by Orchestration Service)
# ======================================================
STT_API_URL=https://api.farmvaidya.ai/v1/speech-to-text
NMT_API_URL=https://api.farmvaidya.ai/v2/translate
LI_RAG_API_URL=https://api.farmvaidya.ai/v3/api/rag/ask
TTS_API_URL=https://api.farmvaidya.ai/v4/tts/submit

# API Keys that the Orchestrator needs to present to the ML APIs
STT_CLIENT_API_KEY=secret_key_required_by_stt_service
NMT_CLIENT_API_KEY=secret_key_required_by_nmt_service
LI_RAG_CLIENT_API_KEY=secret_key_required_by_li_rag_service
TTS_CLIENT_API_KEY=secret_key_required_by_tts_service

# ======================================================
# IDENTITY SERVICE CONFIG
# ======================================================

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ======================================================
# BILLING SERVICE CONFIG (Razorpay)
# ======================================================
RAZORPAY_API_KEY=your_razorpay_api_key
RAZORPAY_API_SECRET=your_razorpay_api_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ======================================================
# API GATEWAY CONFIG
# ======================================================
DEFAULT_RATE_LIMIT=100/minute

# ======================================================
# WORKER SERVICE CONFIG
# ======================================================
SENDER_EMAIL=
